# SMTP Configuration for email alerts
# For local development with MailHog (docker compose up -d):
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=any
#   SMTP_PASS=any
#
# For production (Gmail, Outlook, or institutional SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FCCTP Status <status@fcctp.edu.pe>

# Comma-separated list of recipients (one or more emails)
NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com
